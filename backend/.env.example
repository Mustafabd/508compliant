# Copy to backend/.env for local development. Never commit the real .env.
# In production (Render/Railway), set these as real environment variables
# in the host's dashboard instead -- this file is only read locally via
# python-dotenv.

# --- Core ---
# Signs session cookies. Required in production; a fixed dev-only default
# is used automatically if unset locally.
SECRET_KEY=

# "production" enables secure (HTTPS-only) session cookies and requires
# SECRET_KEY to be set. Leave unset for local development.
ENVIRONMENT=

# Postgres connection string in production, e.g.
# postgresql://user:pass@host:5432/dbname
# Defaults to a local SQLite file (./508compliant.db) if unset.
DATABASE_URL=

# Public base URL of this deployment, used to build Stripe redirect URLs.
# e.g. https://508compliant.onrender.com
APP_BASE_URL=http://localhost:8000

# --- Stripe (billing) ---
# All three are required for /api/billing/* and the webhook to work; the
# app runs fine without them, those endpoints just return a clear error.
# Secret key from the Stripe dashboard (use a test-mode key while testing).
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (Stripe dashboard -> Webhooks,
# or `stripe listen --print-secret` for local testing).
STRIPE_WEBHOOK_SECRET=
# Price ID (price_...) of the recurring "Pro" subscription price.
STRIPE_PRICE_ID=

# --- Optional ---
# Enables real AI-generated alt text for images via Claude's vision API.
# Without it, images get a placeholder flagged for manual review.
ANTHROPIC_API_KEY=
